<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ConsuntivoOre</AssemblyName>
    <RootNamespace>ConsuntivoOre</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Consuntivo Ore</Product>
    <Company>Stefano Ballarini</Company>
    <Description>Promemoria e consuntivazione delle ore di lavoro</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
