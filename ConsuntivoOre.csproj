<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ConsuntivoOre</AssemblyName>
    <RootNamespace>ConsuntivoOre</RootNamespace>
    <Description>Promemoria e consuntivazione delle ore di lavoro</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core\**;tests\**" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <ProjectReference Include="Core\ConsuntivoOre.Core.csproj" />
  </ItemGroup>

</Project>
