<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Interfaccia in Avalonia. Due versioni dello stesso codice:
    - net10.0-windows10.0.17763.0: Windows, con notifiche toast e avvio automatico dal registro;
    - net10.0: Linux (e sviluppo), con notify-send e avvio automatico da ~/.config/autostart.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net10.0</TargetFrameworks>
    <AssemblyName>ConsuntivoOre</AssemblyName>
    <RootNamespace>ConsuntivoOre</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Promemoria e consuntivazione delle ore di lavoro</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Permette di compilare la versione Windows anche da Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core\**;tests\**" />
    <AvaloniaResource Include="Assets\**" />
    <ProjectReference Include="Core\ConsuntivoOre.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Disegna le finestre senza mostrarle (opzione - -screenshot), per controllare la grafica. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Il toolkit dipende da System.Drawing.Common 4.7.0, che ha una vulnerabilità nota: si forza una versione aggiornata. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

</Project>
