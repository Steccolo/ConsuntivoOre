<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ConsuntivoOre.ViewModels"
        x:Class="ConsuntivoOre.Views.ReportWindow"
        x:DataType="local:ReportViewModel"
        Title="Report settimanale"
        Icon="/Assets/app.ico"
        Width="980" Height="820" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,2*,*,Auto" Margin="32,28,32,24">

    <TextBlock Classes="page-title" Text="Report settimanale" />

    <!-- Settimana -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,20,0,20">
      <Button Classes="square" Content="‹" FontSize="20" Command="{Binding PreviousWeekCommand}" ToolTip.Tip="Settimana precedente" />
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" />
      <Button Classes="square" Content="›" FontSize="20" Command="{Binding NextWeekCommand}" ToolTip.Tip="Settimana successiva" />
      <Button Content="Questa settimana" Command="{Binding ThisWeekCommand}" />
    </StackPanel>

    <!-- Dettaglio: si copia la singola cella -->
    <Border Classes="card compact" Grid.Row="2" Margin="0,0,0,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="title" Text="Dettaglio per giorno" Margin="0,0,0,12" />
        <DataGrid x:Name="DetailsGrid" Classes="cells" Grid.Row="1" ItemsSource="{Binding Details}"
                  SelectionMode="Single" IsReadOnly="True" CanUserSortColumns="False"
                  CanUserReorderColumns="False" ClipboardCopyMode="None">
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="local:ReportRow">
              <Setter Property="Background" Value="{Binding Background}" />
              <Setter Property="Foreground" Value="{Binding Foreground}" />
              <Setter Property="FontWeight" Value="{Binding Weight}" />
              <Setter Property="MinHeight" Value="40" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="CopyMenu" Header="Copia" InputGesture="Ctrl+C" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Client}" Width="220" x:DataType="local:ReportRow" />
            <DataGridTextColumn Header="ORE" Binding="{Binding Hours}" Width="80" x:DataType="local:ReportRow" />
            <DataGridTextColumn Header="JIRA" Binding="{Binding Jira}" Width="200" x:DataType="local:ReportRow" />
            <DataGridTextColumn Header="NOTA" Binding="{Binding Note}" Width="*" x:DataType="local:ReportRow" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Classes="hint" Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,0" />
      </Grid>
    </Border>

    <!-- Totale per cliente -->
    <Border Classes="card compact" Grid.Row="3" Margin="0,0,0,20">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="title" Text="Totale per cliente" Margin="0,0,0,12" />
        <DataGrid x:Name="ClientsGrid" Grid.Row="1" ItemsSource="{Binding ByClient}" IsReadOnly="True" CanUserSortColumns="False"
                  CanUserReorderColumns="False">
          <DataGrid.Styles>
            <Style Selector="DataGridRow">
              <Setter Property="MinHeight" Value="40" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Client}" Width="*" x:DataType="local:ClientRow" />
            <DataGridTextColumn Header="ORE" Binding="{Binding Hours}" Width="100" x:DataType="local:ClientRow" />
            <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="100" x:DataType="local:ClientRow" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <TextBlock Classes="total" Text="{Binding Total}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button Classes="accent" Content="{Binding SendText}" Command="{Binding SendToTempoCommand}"
                IsVisible="{Binding JiraEnabled}"
                ToolTip.Tip="Invia a Tempo le voci della settimana collegate a una issue e non ancora inviate o modificate" />
        <Button Content="Copia testo" Command="{Binding CopyTextCommand}" />
        <Button Content="Esporta CSV…" Command="{Binding ExportCsvCommand}" />
        <Button Content="Chiudi" x:Name="CloseButton" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
