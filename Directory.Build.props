<Project>

  <PropertyGroup>
    <!-- Unica fonte della versione: build.ps1 la passa anche all'installer. -->
    <Version>1.0.0</Version>
    <Product>Consuntivo Ore</Product>
    <Company>Stefano Ballarini</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
